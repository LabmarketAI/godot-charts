{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labmarket.ai/godot-charts/m1/plot-message.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "message_id", "session_id", "sequence", "operation", "plot_id", "revision", "created_at", "producer", "payload", "provenance"],
  "properties": {
    "schema": { "const": "godot-charts/plot-message/1.0" },
    "message_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "session_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "sequence": { "type": "integer", "minimum": 0 },
    "operation": { "const": "replace" },
    "plot_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "revision": { "$ref": "common.schema.json#/$defs/revision" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "producer": { "$ref": "common.schema.json#/$defs/producer" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "diagnostics": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "common.schema.json#/$defs/diagnostic" }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figure"],
      "properties": {
        "figure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "views", "data"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/identifier" },
            "title": { "type": "string", "maxLength": 256 },
            "views": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "coordinate_system", "layers", "scales"],
                "properties": {
                  "id": { "$ref": "common.schema.json#/$defs/identifier" },
                  "coordinate_system": { "const": "cartesian_3d" },
                  "layers": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["id", "mark", "data_id", "mappings"],
                      "properties": {
                        "id": { "$ref": "common.schema.json#/$defs/identifier" },
                        "mark": { "const": "point" },
                        "data_id": { "$ref": "common.schema.json#/$defs/identifier" },
                        "mappings": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["x", "y", "z"],
                          "properties": {
                            "x": { "$ref": "common.schema.json#/$defs/identifier" },
                            "y": { "$ref": "common.schema.json#/$defs/identifier" },
                            "z": { "$ref": "common.schema.json#/$defs/identifier" },
                            "color": { "$ref": "common.schema.json#/$defs/identifier" }
                          }
                        }
                      }
                    }
                  },
                  "scales": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["x", "y", "z"],
                    "properties": {
                      "x": { "$ref": "#/$defs/continuous_scale" },
                      "y": { "$ref": "#/$defs/continuous_scale" },
                      "z": { "$ref": "#/$defs/continuous_scale" }
                    }
                  }
                }
              }
            },
            "data": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "$ref": "#/$defs/inline_table" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "continuous_scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "domain"],
      "properties": {
        "type": { "const": "linear" },
        "domain": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "items": false
        }
      }
    },
    "inline_table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "row_ids", "columns"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/identifier" },
        "revision": { "$ref": "common.schema.json#/$defs/revision" },
        "row_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/row_id" }
        },
        "columns": {
          "type": "object",
          "minProperties": 3,
          "maxProperties": 64,
          "additionalProperties": {
            "type": "array",
            "maxItems": 10000,
            "items": { "$ref": "common.schema.json#/$defs/nullable_scalar" }
          }
        }
      }
    }
  }
}
