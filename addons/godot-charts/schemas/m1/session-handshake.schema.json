{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labmarket.ai/godot-charts/m1/session-handshake.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "message_id", "session_id", "sequence", "created_at", "operation", "payload"],
  "properties": {
    "schema": { "const": "godot-charts/session-handshake/1.0" },
    "message_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "session_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "sequence": { "type": "integer", "minimum": 0 },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "operation": { "const": "hello" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peer_id", "protocol_versions", "capabilities", "limits"],
      "properties": {
        "peer_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "protocol_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "const": "1.0" }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["plot.replace", "table.result", "selection.replace", "diagnostics"] }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_message_bytes", "max_rows", "max_columns", "max_layers"],
          "properties": {
            "max_message_bytes": { "type": "integer", "minimum": 1024 },
            "max_rows": { "type": "integer", "minimum": 1 },
            "max_columns": { "type": "integer", "minimum": 1 },
            "max_layers": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
