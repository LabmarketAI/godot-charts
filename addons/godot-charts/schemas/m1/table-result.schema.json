{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labmarket.ai/godot-charts/m1/table-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "message_id", "session_id", "sequence", "operation", "created_at", "payload", "provenance"],
  "properties": {
    "schema": { "const": "godot-charts/table-result/1.0" },
    "message_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "session_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "sequence": { "type": "integer", "minimum": 0 },
    "operation": { "const": "table.result" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "dataset_id", "revision", "offset", "limit", "total_rows", "columns", "rows"],
      "properties": {
        "request_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "dataset_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "revision": { "$ref": "common.schema.json#/$defs/revision" },
        "offset": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "total_rows": { "type": "integer", "minimum": 0 },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "data_type"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/identifier" },
              "label": { "type": "string", "maxLength": 128 },
              "data_type": { "enum": ["float64", "string"] },
              "nullable": { "type": "boolean" }
            }
          }
        },
        "rows": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["row_id", "values"],
            "properties": {
              "row_id": { "$ref": "common.schema.json#/$defs/row_id" },
              "values": {
                "type": "array",
                "maxItems": 64,
                "items": { "$ref": "common.schema.json#/$defs/nullable_scalar" }
              }
            }
          }
        }
      }
    }
  }
}
