[application]
config/name="Godot Charts M2 Interactive Frame Quickstart"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]
enabled=PackedStringArray("res://addons/godot-charts/plugin.cfg")

[rendering]
renderer/rendering_method="gl_compatibility"
