{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labmarket.ai/godot-charts/m1/table-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "message_id", "session_id", "sequence", "operation", "created_at", "payload"],
  "properties": {
    "schema": { "const": "godot-charts/table-request/1.0" },
    "message_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "session_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "sequence": { "type": "integer", "minimum": 0 },
    "operation": { "const": "table.request" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "dataset_id", "dataset_revision", "offset", "limit", "column_ids"],
      "properties": {
        "request_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "dataset_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "dataset_revision": { "$ref": "common.schema.json#/$defs/revision" },
        "offset": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "column_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/identifier" }
        }
      }
    }
  }
}
